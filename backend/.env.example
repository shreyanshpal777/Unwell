PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/welltrack

# Supabase (Session pooler) example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:8443
COOKIE_SECURE=false
SEED_PASSWORD=welltrack

# Connection pool settings (lower PG_POOL_MAX on serverless hosts)
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
